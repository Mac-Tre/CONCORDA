{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concorda.app/schemas/conflict_classification.schema.json",
  "title": "Conflict Classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["primary_conflict_type", "secondary_conflict_types", "escalation_level", "safety_flags", "repair_coaching_allowed", "recommended_module_ids", "memory_relevance", "brief_reasoning"],
  "properties": {
    "primary_conflict_type": { "$ref": "#/$defs/conflict_type" },
    "secondary_conflict_types": { "type": "array", "items": { "$ref": "#/$defs/conflict_type" }, "uniqueItems": true },
    "escalation_level": { "type": "string", "enum": ["low", "moderate", "high", "safety_crisis"] },
    "safety_flags": { "type": "array", "items": { "type": "string", "enum": ["threats", "coercion", "intimidation", "stalking", "physical_violence", "sexual_coercion", "self_harm", "fear_based_compliance", "isolation", "monitoring"] }, "uniqueItems": true },
    "repair_coaching_allowed": { "type": "boolean" },
    "recommended_module_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "memory_relevance": { "type": "string", "enum": ["none", "low", "medium", "high"] },
    "brief_reasoning": { "type": "string" }
  },
  "$defs": {
    "conflict_type": { "type": "string", "enum": ["trust_disclosure_conflict", "pursuer_defender_loop", "accountability_impasse", "repair_after_betrayal_or_perceived_betrayal", "power_agency_conflict", "future_versus_past_conflict", "definition_conflict", "attention_availability_conflict", "money_labor_ambition_conflict", "household_logistics_conflict", "parenting_family_system_conflict", "boundary_third_party_conflict", "meta_communication_conflict", "chronic_resentment_scorekeeping", "safety_coercion_crisis", "transparency_versus_amnesty", "disclosure_versus_confession", "mutual_disclosure_parity", "trauma_reactivation", "decision_relevant_facts", "answer_sufficiency_dispute"] }
  }
}
