{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concorda.app/schemas/input-envelope.schema.json",
  "title": "InputEnvelope",
  "description": "Canonical normalized envelope for multimodal inputs across providers and devices.",
  "type": "object",
  "required": ["envelope_id", "session_id", "source", "inputs", "received_at"],
  "properties": {
    "envelope_id": { "type": "string" },
    "session_id": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["channel", "provider"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["mobile", "web", "api", "calendar_hook", "email_ingest", "file_import", "voice"]
        },
        "provider": {
          "type": "string",
          "enum": ["native", "google", "microsoft", "apple", "adobe", "openai", "custom"]
        },
        "device_id": { "type": "string" },
        "user_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["input_id", "modality", "payload_ref"],
        "properties": {
          "input_id": { "type": "string" },
          "modality": {
            "type": "string",
            "enum": ["text", "audio", "image", "video", "document", "event", "structured_json"]
          },
          "mime_type": { "type": "string" },
          "language": { "type": "string" },
          "payload_ref": {
            "type": "string",
            "description": "Secure object reference, not raw blob in payload."
          },
          "tokens_estimate": { "type": "integer", "minimum": 0 },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "normalization": {
      "type": "object",
      "properties": {
        "transcript_ref": { "type": "string" },
        "ocr_text_ref": { "type": "string" },
        "embedding_ref": { "type": "string" },
        "safety_labels": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "received_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
