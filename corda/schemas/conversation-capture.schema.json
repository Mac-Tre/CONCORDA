{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concorda.app/schemas/conversation-capture.schema.json",
  "title": "ConversationCapture",
  "description": "Capture metadata for couple conversations (passive recording or active facilitation).",
  "type": "object",
  "required": [
    "capture_id",
    "session_id",
    "mode",
    "both_partners_present",
    "partner_attestation",
    "media"
  ],
  "properties": {
    "capture_id": { "type": "string" },
    "session_id": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": ["passive_record_playback", "active_facilitation"]
    },
    "both_partners_present": { "type": "boolean" },
    "partner_attestation": {
      "type": "object",
      "required": ["partner_a", "partner_b"],
      "properties": {
        "partner_a": { "type": "boolean" },
        "partner_b": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": ["audio_enabled"],
      "properties": {
        "audio_enabled": { "type": "boolean" },
        "audio_ref": { "type": "string" },
        "transcript_ref": { "type": "string" },
        "duration_seconds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "confidence_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "single_sided_account",
          "partner_missing",
          "no_attestation",
          "no_recording",
          "partial_transcript"
        ]
      },
      "default": []
    }
  },
  "additionalProperties": false
}
