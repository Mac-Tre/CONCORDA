{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concorda.app/schemas/argument-event.schema.json",
  "title": "ArgumentEvent",
  "description": "Atomic event unit for dialogue turns, interventions, and observations.",
  "type": "object",
  "required": [
    "event_id",
    "session_id",
    "timestamp_utc",
    "speaker",
    "event_type",
    "content",
    "metrics"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 8 },
    "session_id": { "type": "string", "minLength": 8 },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "speaker": {
      "type": "string",
      "enum": ["partner_a", "partner_b", "corda", "system"]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "statement",
        "question",
        "reflection",
        "repair_attempt",
        "boundary_statement",
        "interruption",
        "escalation_marker",
        "deescalation_marker",
        "safety_marker",
        "coach_intervention"
      ]
    },
    "content": { "type": "string", "minLength": 1 },
    "topic_tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "claim_objects": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_text", "evidence_level"],
        "properties": {
          "claim_id": { "type": "string" },
          "claim_text": { "type": "string" },
          "evidence_level": {
            "type": "string",
            "enum": ["none", "anecdotal", "partial", "strong", "verified"]
          },
          "verifiability": {
            "type": "string",
            "enum": ["not_verifiable", "internally_verifiable", "externally_verifiable"]
          },
          "truth_grounding_score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "word_count",
        "sentiment_valence",
        "emotional_intensity",
        "accountability_signal",
        "empathy_signal",
        "respect_signal"
      ],
      "properties": {
        "word_count": { "type": "integer", "minimum": 0 },
        "sentiment_valence": { "type": "number", "minimum": -1, "maximum": 1 },
        "emotional_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "accountability_signal": { "type": "number", "minimum": 0, "maximum": 1 },
        "empathy_signal": { "type": "number", "minimum": 0, "maximum": 1 },
        "respect_signal": { "type": "number", "minimum": 0, "maximum": 1 },
        "dominance_signal": { "type": "number", "minimum": 0, "maximum": 1 },
        "interruption_flag": { "type": "boolean", "default": false },
        "possible_abuse_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "threat_language",
              "coercive_control",
              "isolation_pattern",
              "financial_control",
              "intimidation",
              "degradation_humiliation",
              "sexual_coercion",
              "physical_harm_reference",
              "self_harm_threat_as_control"
            ]
          },
          "default": []
        }
      }
    },
    "initiator_context": {
      "type": "object",
      "properties": {
        "initiated_topic": { "type": "boolean" },
        "initiation_style": {
          "type": "string",
          "enum": ["gentle", "direct", "critical", "defensive", "avoidant", "unknown"]
        }
      },
      "default": {}
    }
  },
  "additionalProperties": false
}
